# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (unpooled) connection, used by Prisma Migrate / introspection.
# On Neon this is the same host without the `-pooler` suffix.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth ------------------------------------------------------------------
# HS256 signing secret for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-32-byte-random-hex-string"
# Session lifetime, in seconds (default 7 days).
JWT_EXPIRES_IN="604800"
# Name of the httpOnly session cookie.
AUTH_COOKIE_NAME="lm_session"

# --- Notifications ---------------------------------------------------------
# EMAIL — SMTP via a Gmail account and an app password. Free, and unlike a
# provider's sandbox tier (Resend, SendGrid, etc.) it sends to ANY recipient,
# not only the account owner -- the reason it was chosen: this project is
# reviewed by someone else, and a sandbox-restricted provider would silently
# fail to reach them. Leave SMTP_USER / SMTP_PASS unset and email is logged,
# never sent -- the app reports "not sent" rather than pretending.
#
# Generate an app password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification enabled on the Google account first). It is a
# 16-character password scoped to SMTP -- not the account's real password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="replace-with-a-16-char-app-password"
EMAIL_FROM_NAME="Last-Mile Delivery"

# SMS — not implemented. The SMS channel is a stub that logs the message it
# would send and reports delivered=false. See the README for why, and for how
# to swap in a real provider.

# --- Seed accounts ---------------------------------------------------------
# Required by `npm run db:seed` -- it has no built-in defaults on purpose, so a
# working password can never sit in the repository. Re-running the seed rewrites
# these accounts' password hashes, which is also how you rotate them.
SEED_ADMIN_EMAIL="admin@lastmile.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_AGENT_PASSWORD="replace-with-a-strong-password"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
